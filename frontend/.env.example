# Environment Variables Template - Copy to .env
# After copying, rename this file to .env and add your real API keys

# Google API Key (Required for Maps & Places - Masjid Finder)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Maps SDK for iOS/Android + Places API
EXPO_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here

# OpenCage Geocoding API (Required for location names)
# Get from: https://opencagedata.com/api
EXPO_PUBLIC_OPENCAGE_API_KEY=your_opencage_api_key_here

# Prayer Times API (No key needed)
EXPO_PUBLIC_ALADHAN_API=https://api.aladhan.com/v1

# OpenWeatherMap API (Optional - for weather notifications)
# Get from: https://openweathermap.org/api
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Maps URL for "Find Mosque" feature
EXPO_PUBLIC_GOOGLE_MAPS_URL=https://www.google.com/maps/search/mosque/
